# =====================================================================
# Settings for Conversation Insights.
# Copy this file to ".env" (same folder) and edit .env, not this file.
# After changing .env, restart the server and run:  python -m src.check_llm
# =====================================================================

# ---------------------------------------------------------------------
# 1. WHICH LLM TO USE
#    mock      = offline keyword rules, NOT an LLM (no key needed; default)
#    groq      = free, no credit card            -> fill GROQ_API_KEY
#    gemini    = free tier from Google           -> fill GEMINI_API_KEY
#    ollama    = free, runs on your own computer -> no key; install Ollama
#    anthropic = Claude, paid                    -> fill ANTHROPIC_API_KEY
#    openai    = OpenAI, paid                    -> fill OPENAI_API_KEY
# ---------------------------------------------------------------------
LLM_PROVIDER=mock

# Leave empty to use the default model for the provider:
#   groq: llama-3.3-70b-versatile   gemini: gemini-flash-latest
#   ollama: llama3.1:8b             anthropic: claude-haiku-5-5
#   openai: gpt-4o-mini
# To see other names your key can use: python -m src.check_llm --models
LLM_MODEL=

# ---------------------------------------------------------------------
# 2. API KEYS: fill in only the one for the provider you chose above.
#    Paste the key right after "=", with no quotes and no spaces.
# ---------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Only for LLM_PROVIDER=openai with a different OpenAI-compatible server
# (e.g. a company gateway, vLLM, LM Studio). Leave empty for OpenAI itself.
OPENAI_BASE_URL=

# ---------------------------------------------------------------------
# 3. SPEED AND RATE LIMITS
# ---------------------------------------------------------------------
# How many conversations are sent to the LLM at the same time in batch jobs.
# Free tiers (groq, gemini) have per-minute limits: use 1. Ollama: use 1.
# Paid tiers: 4-8 is fine.
LLM_WORKERS=4
# Automatic retries when the provider says "rate limited" or the network blips.
LLM_SDK_RETRIES=5
# Extra attempts when the model's answer is not valid JSON.
MAX_RETRIES=2
# 0 = most repeatable answers. Keep it at 0 for labelling tasks.
LLM_TEMPERATURE=0
# Maximum length of the model's answer, in tokens. Raise it if answers get cut off.
LLM_MAX_TOKENS=800
# Seconds to wait for one answer. Raise it for slow local models (e.g. 180 for Ollama on CPU).
LLM_TIMEOUT_S=60

# ---------------------------------------------------------------------
# 4. RARELY NEEDED
# ---------------------------------------------------------------------
# Make the mock return broken JSON on a share of calls, to see the retry logic work.
MOCK_FAIL_RATE=0
# Only if you build a separate frontend on another port, e.g. http://localhost:3000
CORS_ORIGINS=
